{
  "name": "minimal-md-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal Typora-inspired Markdown editor for desktop and mobile shells.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:electron": "concurrently -k \"vite --host 0.0.0.0 --force\" \"wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vue-tsc --noEmit && vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "mobile:dev": "vite --host 0.0.0.0",
    "mobile:build": "vite build --mode mobile",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:sync": "npm run build && cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/ios": "^7.4.4",
    "dompurify": "^3.4.3",
    "highlight.js": "^11.11.1",
    "html2pdf.js": "^0.10.3",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.15.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.workbench.minimalmdstudio",
    "productName": "Minimal Markdown Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
